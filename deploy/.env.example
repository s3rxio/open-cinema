# Swarm (после push в registry):
# API_IMAGE=your-registry/open-cinema-api:latest
# WEB_IMAGE=your-registry/open-cinema-web:latest

# --- Публичные URL (для сборки web и браузера) ---
# URL GraphQL, доступный с машины пользователя (не внутренний hostname Docker)
PUBLIC_GRAPHQL_URL=http://localhost:5000/graphql
# Socket.IO; если пусто — origin берётся из PUBLIC_GRAPHQL_URL
PUBLIC_WS_URL=http://localhost:5000

# --- PostgreSQL ---
# Пароль фиксируется при первом запуске тома. Если том уже создан через docker-compose.yml
# в корне репозитория, используйте open_cinema_local или выполните: docker compose -f deploy/compose.yml down -v
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=open_cinema

# --- Redis ---
REDIS_PASSWORD=

# --- S3 (RustFS) ---
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=change_me

# --- API ---
API_HOST=0.0.0.0
API_PORT=5000
API_SECRET=change_me_long_random_string
API_BCRYPT_SALT=change_me_bcrypt_salt
API_BCRYPT_SALT_ROUNDS=10
API_JWT_SECRET=change_me_jwt_secret
API_TOKEN_ACCESS_LIFETIME=15m
API_TOKEN_REFRESH_LIFETIME=7d

# Временные файлы загрузок и ffmpeg (абсолютный путь).
# В Docker (deploy/compose.yml) том смонтирован в /tmp/open-cinema-media — не меняйте путь без правки volumes в compose.
API_MEDIA_TMP_DIR=/tmp/open-cinema-media

# Миграции и сиды при старте API (true | false)
RUN_MIGRATIONS=true
# Сиды идемпотентны не полностью — включайте только на чистой БД или первом деплое
RUN_SEEDS=true

# Порты на хосте (опционально)
API_PUBLISH_PORT=5000
WEB_PUBLISH_PORT=3000
POSTGRES_PUBLISH_PORT=5432
REDIS_PUBLISH_PORT=6379
RUSTFS_API_PUBLISH_PORT=9000
RUSTFS_CONSOLE_PUBLISH_PORT=9001
