# Локальная разработка OpenCinema
#
# Скопируйте в .env.local и при необходимости измените значения:
#   cp .env.example .env.local
#
# Файл используется:
#   - NestJS API (apps/api) — переменные API_*
#   - docker compose (корневой) — env_file для postgres
#
# Переменные web-клиента: apps/web/.env.example → apps/web/.env.local

# --- Runtime ---
NODE_ENV=development

# --- API ---
API_HOST=localhost
API_PORT=5000
API_URL=http://localhost:5000

# --- PostgreSQL ---
# Пароль должен совпадать с docker-compose.yml (POSTGRES_PASSWORD: open_cinema_local)
API_DB_URL=postgresql://postgres:open_cinema_local@localhost:5432/open_cinema

# --- Redis ---
API_REDIS_HOST=localhost
API_REDIS_PORT=6379
API_REDIS_PASSWORD=

# --- Crypto / JWT ---
# Только для локальной разработки — в production задайте длинные случайные значения
API_SECRET=dev-secret-change-me
API_BCRYPT_SALT=10
API_BCRYPT_SALT_ROUNDS=10
API_JWT_SECRET=dev-jwt-secret-change-me
API_TOKEN_ACCESS_LIFETIME=15m
API_TOKEN_REFRESH_LIFETIME=7d

# --- S3 (RustFS из docker compose) ---
# Создайте bucket open-cinema в консоли: http://localhost:9001
API_S3_ENDPOINT=http://localhost:9000
API_S3_REGION=us-east-1
API_S3_BUCKET=open-cinema
API_S3_ACCESS_KEY_ID=rustfsadmin
API_S3_SECRET_ACCESS_KEY=rustfsadmin

# --- Media processing ---
API_MEDIA_TMP_DIR=/tmp/open-cinema-media
